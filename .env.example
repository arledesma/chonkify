# -- Azure OpenAI backend --
# Azure OpenAI resource endpoint (Azure Portal > your Cognitive Services resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=
# API key for the Azure OpenAI resource (same Keys and Endpoint page)
AZURE_OPENAI_API_KEY=
# Azure OpenAI REST API version (see https://learn.microsoft.com/en-us/azure/ai-services/openai/reference)
AZURE_OPENAI_API_VERSION=
# Name of your embedding model deployment (Azure AI Studio > Deployments; must output 768 dimensions)
CHONKIFY_AZURE_EMBEDDING_DEPLOYMENT=

# -- OpenAI backend --
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Embedding model (defaults to text-embedding-3-large if unset)
CHONKIFY_OPENAI_EMBEDDING_MODEL=

# -- OpenAI-compatible backend --
# Base URL for the compatible API (e.g. Together, Fireworks, or self-hosted)
CHONKIFY_OPENAI_BASE_URL=

# -- Local backend --
# Which backend demo.py defaults to: azure, openai, openai-compatible, or local
CHONKIFY_DEMO_BACKEND=
# Device for local embeddings: cpu, cuda, cuda:0, mps
CHONKIFY_DEMO_LOCAL_DEVICE=
